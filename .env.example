# =============================================================================
# RxGuard environment configuration (Supabase pivot — see plan.md)
# Copy to `.env` and adjust. `.env` is gitignored — never commit real secrets.
#
# Keys come from:
#   - Supabase Dashboard → Project Settings → API
#   - Supabase Dashboard → Account → Access Tokens (PAT)
#   - https://console.groq.com/keys
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (cloud Postgres + Auth + RLS)
# -----------------------------------------------------------------------------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon key — client-side, safe to expose in the browser>
SUPABASE_SERVICE_ROLE_KEY=<service role key — server/Edge Functions only>
SUPABASE_ACCESS_TOKEN=<Supabase PAT — CLI + Management API only, never ship it>
SUPABASE_PROJECT_REF=<project-ref>

# -----------------------------------------------------------------------------
# AI (Groq LLM — adaptive interview + final assessment)
# Get a key at https://console.groq.com/keys
# -----------------------------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# -----------------------------------------------------------------------------
# External data (no API key required)
# -----------------------------------------------------------------------------
RXNORM_BASE_URL=https://rxnav.nlm.nih.gov/REST
OPENFDA_BASE_URL=https://api.fda.gov

# -----------------------------------------------------------------------------
# Next.js frontend
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=${SUPABASE_URL}
NEXT_PUBLIC_SUPABASE_ANON_KEY=${SUPABASE_ANON_KEY}
NEXT_PUBLIC_GROQ_MODEL=${GROQ_MODEL}