# RxGuard web app environment — copy to .env.local with real values.
# All Supabase keys below are public (browser-safe); server-only secrets
# (service role, Groq) live in the Edge Functions, never here.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key from Supabase Dashboard → Settings → API>
NEXT_PUBLIC_GROQ_MODEL=openai/gpt-oss-120b