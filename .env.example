# =============================================================================
# RxGuard environment configuration
# Copy to `.env` and adjust. `.env` is gitignored — never commit real secrets.
#
# NOTE: Docker Compose overrides DATABASE_URL/REDIS_URL with its own
#       service-host values (see infra/docker-compose.yml). The defaults here
#       target host-local Postgres/Redis for running uvicorn directly on your
#       machine during development.
# =============================================================================

# -----------------------------------------------------------------------------
# AI (Groq LLM — used for explanation generation, Phase 2+)
# Get a key at https://console.groq.com/keys
# -----------------------------------------------------------------------------
GROQ_API_KEY=
# Verify the current model list at https://console.groq.com/docs/models —
# hosted models rotate. Default was current at spec time.
GROQ_MODEL=llama-3.3-70b-versatile

# -----------------------------------------------------------------------------
# External data (no API key required)
# -----------------------------------------------------------------------------
RXNORM_BASE_URL=https://rxnav.nlm.nih.gov/REST
OPENFDA_BASE_URL=https://api.fda.gov

# -----------------------------------------------------------------------------
# Data stores (host-local dev defaults; compose overrides these)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://rxguard:rxguard@localhost:5432/rxguard
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# Auth
# -----------------------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRY_MINUTES=60

# -----------------------------------------------------------------------------
# Service ports (host-local uvicorn dev; compose also exposes these)
# -----------------------------------------------------------------------------
USER_SERVICE_PORT=8001
PATIENT_SERVICE_PORT=8002
PRESCRIPTION_SERVICE_PORT=8003
INTERACTION_SERVICE_PORT=8004
ALERT_SERVICE_PORT=8005
ANALYTICS_SERVICE_PORT=8006
AUDIT_SERVICE_PORT=8007
API_GATEWAY_PORT=8000
FRONTEND_PORT=5173
